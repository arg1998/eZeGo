# SDL 3 through its own CMake build, options set by us (B-8): a static library with the video and
# event subsystems only (windowing.md §2). Another subsystem is a flag flip when a module needs it.
set(SDL_SHARED OFF)
set(SDL_STATIC ON)
set(SDL_TEST_LIBRARY OFF)
set(SDL_TESTS OFF)
set(SDL_EXAMPLES OFF)
set(SDL_INSTALL OFF)
set(SDL_INSTALL_DOCS OFF)
set(SDL_UNINSTALL OFF)
set(SDL_AUDIO OFF)     # the audio library question is open (philosophy.md §6)
set(SDL_GPU OFF)
set(SDL_RENDER OFF)
set(SDL_CAMERA OFF)
set(SDL_JOYSTICK OFF)
set(SDL_HAPTIC OFF)
set(SDL_HIDAPI OFF)
set(SDL_POWER OFF)
set(SDL_SENSOR OFF)
set(SDL_DIALOG OFF)
set(SDL_TRAY OFF)
if(UNIX AND NOT APPLE)
  set(SDL_X11 ON)
  set(SDL_WAYLAND ON)
  set(SDL_WAYLAND_LIBDECOR OFF)   # the window is borderless and draws its own title bar (windowing.md W-2)
  set(SDL_KMSDRM OFF)
  # X11 extensions the window does not use. SDL stops the configure when their headers are missing,
  # so they are off rather than extra packages to install. Screensaver inhibition still works
  # through D-Bus on X11 when libdbus is present, and through idle-inhibit on Wayland.
  set(SDL_X11_XSCRNSAVER OFF)
  set(SDL_X11_XTEST OFF)
  set(SDL_X11_XSHAPE OFF)
endif()
# The static C runtime on Windows comes from CMAKE_MSVC_RUNTIME_LIBRARY (cmake/toolchain.cmake, L-3).
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)   # let the variables above win over option()
add_subdirectory("${EZ_DEP_sdl3_DIR}" "${CMAKE_BINARY_DIR}/third_party/sdl3" EXCLUDE_FROM_ALL SYSTEM)
ez_third_party(SDL3-static)
add_library(sdl3 INTERFACE)
target_link_libraries(sdl3 INTERFACE SDL3::SDL3-static)
