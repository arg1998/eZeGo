{
  // Tracked, no machine-specific paths: works when VS Code opens the folder. Every task maps
  // one-to-one onto a command you can type in a terminal (B-13).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ez: doctor",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/doctor.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ez: init",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/init.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ez: deps (sync to manifest)",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/deps.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ez: tools (install pinned dev tools)",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/tools.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ez: check (lint + build + test, warnings are errors)",
      "type": "process",
      "command": "cmake",
      "args": ["--workflow", "--preset", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": "test"
    },
    {
      "label": "ez: lint (naming, layout, format, clang-tidy)",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/lint.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "ez-lint",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(?:(\\d+):)?\\s+(?:\\x1b\\[[0-9;]*m)?(error|warning)(?:\\x1b\\[[0-9;]*m)?:\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "ez: lint --fix (apply clang-format)",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/lint.cmake", "--fix", "--tidy=off"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ez: profile (build profile, open Tracy, run)",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/profile.cmake"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "tracy: open GUI",
      "type": "process",
      "command": "cmake",
      "args": ["-P", "scripts/profile.cmake", "--gui-only"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
