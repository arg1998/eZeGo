# Helpers shared by tools.cmake, doctor.cmake, profile.cmake and the VS Code generator.

function(ez_tool_install_dir dep out)
  ez_manifest_get(${dep} version version)
  ez_tools_root(root)
  set(${out} "${root}/${dep}-${version}" PARENT_SCOPE)
endfunction()

# state: OK | MISSING | STALE ; origin: human-readable provenance summary
function(ez_tool_state dep out_state out_origin)
  ez_tool_install_dir(${dep} dir)
  ez_manifest_get(${dep} version version)
  ez_manifest_get(${dep} commit commit)
  set(prov "${dir}/PROVENANCE.json")
  if(NOT EXISTS "${prov}")
    set(${out_state} MISSING PARENT_SCOPE)
    set(${out_origin} "" PARENT_SCOPE)
    return()
  endif()
  file(READ "${prov}" j)
  string(JSON v ERROR_VARIABLE e1 GET "${j}" version)
  string(JSON c ERROR_VARIABLE e2 GET "${j}" commit)
  string(JSON o ERROR_VARIABLE e3 GET "${j}" origin)
  string(JSON n ERROR_VARIABLE e4 LENGTH "${j}" binaries)
  set(state OK)
  if(e1 OR e2 OR NOT v STREQUAL version OR NOT c STREQUAL commit)
    set(state STALE)
  elseif(NOT e4 AND n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last})
      string(JSON k MEMBER "${j}" binaries ${i})
      string(JSON rel GET "${j}" binaries ${k})
      if(NOT EXISTS "${dir}/${rel}")
        set(state STALE)
      endif()
    endforeach()
  endif()
  if(o STREQUAL "prebuilt")
    set(o "prebuilt, verified")
  elseif(o STREQUAL "source")
    string(SUBSTRING "${c}" 0 10 s)
    set(o "built from source ${s}")
  endif()
  set(${out_state} ${state} PARENT_SCOPE)
  set(${out_origin} "${o}" PARENT_SCOPE)
endfunction()

# Absolute path of one installed binary (empty if not installed).
function(ez_tool_binary dep bin out)
  ez_tool_install_dir(${dep} dir)
  set(prov "${dir}/PROVENANCE.json")
  set(${out} "" PARENT_SCOPE)
  if(EXISTS "${prov}")
    file(READ "${prov}" j)
    string(JSON rel ERROR_VARIABLE e GET "${j}" binaries ${bin})
    if(NOT e)
      set(${out} "${dir}/${rel}" PARENT_SCOPE)
    endif()
  endif()
endfunction()

function(ez_dep_is_current dep out)
  ez_manifest_get(${dep} commit commit)
  set(stamp "${EZ_STAMP_DIR}/${dep}")
  set(ok OFF)
  if(EXISTS "${stamp}")
    file(STRINGS "${stamp}" have LIMIT_COUNT 1)
    if(have STREQUAL commit AND EXISTS "${EZ_SRC_ROOT}/${dep}/.git")
      set(ok ON)
    endif()
  endif()
  set(${out} ${ok} PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------ VS Code (B-13)
# Tracked .vscode/ files contain no machine paths; this generated, git-ignored workspace file
# holds everything discovered on this machine. Regenerated by init and tools.
function(_ez_json_str out value)
  string(REPLACE "\\" "/" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(ez_write_vscode_workspace)
  set(ws "${EZ_ROOT}/eZeGo.code-workspace")
  find_program(_clangd NAMES clangd clangd-22 clangd-21 clangd-20 clangd-19 clangd-18 clangd-17 NO_CACHE)
  find_program(_ninja NAMES ninja NO_CACHE)
  ez_tool_binary(tracy profiler _tracy)
  ez_tool_binary(tracy capture _capture)

  set(s "{}")
  _ez_json_str(v "${CMAKE_COMMAND}")
  string(JSON s SET "${s}" "cmake.cmakePath" "${v}")
  string(JSON s SET "${s}" "cmake.useCMakePresets" "\"always\"")
  string(JSON s SET "${s}" "cmake.configureOnOpen" "true")
  string(JSON s SET "${s}" "cmake.copyCompileCommands" "\"\${workspaceFolder}/build/compile_commands.json\"")
  string(JSON s SET "${s}" "cmake.ctest.testExplorerIntegrationEnabled" "true")
  if(_ninja)
    _ez_json_str(v "${_ninja}")
    string(JSON s SET "${s}" "cmake.configureSettings" "{\"CMAKE_MAKE_PROGRAM\": ${v}}")
  endif()
  if(_clangd)
    _ez_json_str(v "${_clangd}")
    string(JSON s SET "${s}" "clangd.path" "${v}")
  endif()
  string(JSON s SET "${s}" "clangd.arguments"
    "[\"--compile-commands-dir=\${workspaceFolder}/build\", \"--header-insertion=never\", \"--background-index\"]")
  string(JSON s SET "${s}" "C_Cpp.intelliSenseEngine" "\"disabled\"")
  string(JSON s SET "${s}" "editor.formatOnSave" "true")
  string(JSON s SET "${s}" "search.exclude" "{\"build\": true, \"third_party/_src\": true}")
  string(JSON s SET "${s}" "files.watcherExclude" "{\"**/build/**\": true, \"**/third_party/_src/**\": true}")
  # Values the tracked tasks.json / launch.json read through ${config:ezego.*}
  _ez_json_str(v "${CMAKE_COMMAND}")
  string(JSON s SET "${s}" "ezego.cmake" "${v}")
  _ez_json_str(v "${_tracy}")
  string(JSON s SET "${s}" "ezego.tracyProfiler" "${v}")
  _ez_json_str(v "${_capture}")
  string(JSON s SET "${s}" "ezego.tracyCapture" "${v}")

  set(w "{}")
  string(JSON w SET "${w}" "folders" "[{\"path\": \".\"}]")
  string(JSON w SET "${w}" "settings" "${s}")
  file(WRITE "${ws}" "// GENERATED by scripts/tools.cmake / scripts/init.cmake. Do not edit; re-run init.\n// Personal settings belong in .vscode/settings.json.\n${w}\n")
  message("  ${EZ_C_GREEN}ok   ${EZ_C_RESET} VS Code workspace  ${EZ_C_DIM}${ws}${EZ_C_RESET}")
endfunction()
