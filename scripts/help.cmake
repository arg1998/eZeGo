# ---------------------------------------------------------------- dispatch
set(_commands doctor init deps tools vscode build run clean test check lint bench profile help)
if(_topic STREQUAL "")
  help_overview(_text)
elseif(_topic IN_LIST _commands)
  cmake_language(CALL help_${_topic} _text)
else()
  string(REPLACE ";" ", " _list "${_commands}")
  set(_text "${EZ_C_RED}unknown command '${_topic}'${R}\ncommands: ${_list}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_text}")
  message(FATAL_ERROR "")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_text}")
