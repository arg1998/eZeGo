# ---------------------------------------------------------------- build output
# One build tree per preset: build/debug, build/profile, build/release, build/asan, build/tsan
/build/
/out/
compile_commands.json
*.tracy

# ---------------------------------------------------------------- fetched dependencies
# Populated by `./ez deps` from dependencies.json (shallow, pinned). Never committed.
/third_party/_src/

# ---------------------------------------------------------------- personal / generated
# Personal presets (debug-with-Tracy, custom flags, ...)
/CMakeUserPresets.json
# Generated by `./ez init` / `./ez vscode` with this machine's paths
/eZeGo.code-workspace
# Personal profiling defaults (address, port)
/scripts/profile.user.cmake

# ---------------------------------------------------------------- editors
# VS Code: only the machine-independent files are shared
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# clangd index
.cache/
# CLion / Visual Studio / Xcode
.idea/
.vs/
*.xcworkspace/
xcuserdata/

# ---------------------------------------------------------------- Claude Code (local only)
.claude/settings.local.json
.claude/worktrees/

# ---------------------------------------------------------------- OS noise
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp


scratchpad/
